# =============================================================================
# PlaceMate — example environment (copy to .env and fill in real values)
# NEVER commit a filled .env. Placeholders only.
# =============================================================================

# --- core ---
APP_NAME=PlaceMate
ENV=development
DEBUG=true
# Comma-separated origins allowed by CORS and OAuth redirect checks
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Backend public URL (used to build Google OAuth callback)
API_PUBLIC_URL=http://localhost:8000

# --- database / cache ---
# Docker compose: host "postgres". Local native: localhost.
DATABASE_URL=postgresql+psycopg://placemate:placemate@localhost:5432/placemate
REDIS_URL=redis://localhost:6379/0

# --- auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-64-char-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Google OAuth (optional in demo mode). Redirect URI:
#   {API_PUBLIC_URL}/api/v1/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Enables seeded demo accounts + password login buttons in the UI. Dev only.
DEMO_MODE=true

# --- LLM (provider agnostic) ---
# mock | vertex | gemini | openai  (mock needs no key and is used in CI)
LLM_PROVIDER=mock
LLM_API_KEY=
# Path to a service-account JSON for Vertex AI (never commit the file)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
LLM_MODEL_CHEAP=gemini-2.0-flash-001
LLM_MODEL_SCORING=gemini-2.5-pro
LLM_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
# OpenAI-compatible base URL (only used when LLM_PROVIDER=openai)
LLM_BASE_URL=https://api.openai.com/v1

# --- storage (S3 compatible: R2, MinIO, Supabase, S3) ---
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=placemate-resumes
STORAGE_KEY=placemate
STORAGE_SECRET=replace-me-minio-secret
STORAGE_REGION=auto
STORAGE_SECURE=false
# For local development without MinIO: STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/uploads

# --- limits / cost ---
MAX_UPLOAD_MB=5
PER_USER_MONTHLY_BUDGET=1.50
SCORING_SAMPLES=3
SCORING_MAX_RETRIES=2
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- observability / analytics ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=INFO

# --- frontend (must be prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=PlaceMate
